DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seva?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Used to hash OTP codes at rest. Generate with: openssl rand -base64 32
OTP_SECRET="change-me-too"
# 32-byte key (base64) for encrypting worker ID numbers. Generate with: openssl rand -base64 32
ID_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Comma-separated phone numbers (10 digits) that get the ADMIN role on first login
ADMIN_PHONES="9999999999"

# When true, the OTP is returned in the API response and logged (local dev only — never in production)
OTP_DEV_MODE=true

# Flat booking fee in rupees, charged online once payments are enabled
BOOKING_FEE_RUPEES=49
