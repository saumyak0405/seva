{
  "name": "seva",
  "private": true,
  "description": "Seva \u2014 a trusted marketplace connecting households with verified domestic workers",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "start": "npm start -w apps/api"
  },
  "engines": {
    "node": ">=22"
  }
}
